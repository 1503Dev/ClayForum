{
    "name": "clayforum",
    "version": "0.1.0",
    "description": "A forum framework",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "clayforum": "dist/index.js"
    },
    "scripts": {
        "build": "tsc --project tsconfig.json && copyfiles -u 1 \"src/**/*.!(ts|tsx)\" dist",
        "run": "node -e \"const fs = require('fs'); if (!fs.existsSync('test_instance')) fs.mkdirSync('test_instance');\" && cd test_instance && npx tsx ../src/index.ts",
        "test": "jest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/1503Dev/ClayForum.git"
    },
    "keywords": [
        "Forum"
    ],
    "author": "1503Dev",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/1503Dev/ClayForum/issues"
    },
    "homepage": "https://github.com/1503Dev/ClayForum#readme",
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jest": "^29.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.9.2",
        "@types/sanitize-html": "^2.16.1",
        "jest": "^30.4.2",
        "ts-jest": "^29.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "copyfiles": "^2.4.1",
        "eta": "^4.6.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "level": "^10.0.0",
        "marked": "^18.0.5",
        "multer": "^2.1.1",
        "sanitize-html": "^2.17.4",
        "sha256": "^0.2.0",
        "svg-captcha": "^1.4.0"
    }
}
